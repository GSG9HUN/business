<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RootNamespace>DC_bot</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>MelodiasMario</AssemblyName>
        <TargetFramework>net9.0</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="DotNetEnv" Version="3.1.1" />
        <PackageReference Include="DSharpPlus" Version="5.0.0-nightly-02574" />
        <PackageReference Include="DSharpPlus.Commands" Version="5.0.0-nightly-02574" />
        <PackageReference Include="DSharpPlus.CommandsNext" Version="5.0.0-nightly-02574" />
        <PackageReference Include="DSharpPlus.Interactivity" Version="5.0.0-nightly-02574" />
        <PackageReference Include="DSharpPlus.VoiceNext" Version="5.0.0-nightly-02574" />
        <PackageReference Include="Lavalink4NET" Version="4.2.1" />
        <PackageReference Include="Lavalink4NET.Abstractions" Version="4.2.1" />
        <PackageReference Include="Lavalink4NET.DSharpPlus.Nightly" Version="4.2.1" />
        <PackageReference Include="Lavalink4NET.Integrations.Lavasearch" Version="4.2.1" />
        <PackageReference Include="Lavalink4NET.Lyrics" Version="4.2.1" />
        <PackageReference Include="Lavalink4NET.Protocol" Version="4.2.1" />
        <PackageReference Include="Lavalink4NET.Rest" Version="4.2.1" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
        <PackageReference Include="YoutubeExplode" Version="6.5.3" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\DC bot.Contracts\DC bot.Contracts.csproj" />
        <ProjectReference Include="..\DC bot.Persistence\DC bot.Persistence.csproj" />
    </ItemGroup>
    <ItemGroup>
        <Content Include="localization\**\*.*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
    </ItemGroup>
    <ItemGroup>
        <Content Include="guildFiles\**\*.*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
    </ItemGroup>


</Project>
