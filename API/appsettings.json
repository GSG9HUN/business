{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MusicSearch": {
    "TimeoutSeconds": 10,
    "MaxResults": 20,
    "Providers": {
      "ytsearch": { "Enabled": true, "CanEnqueue": true },
      "ytmsearch": { "Enabled": true, "CanEnqueue": true },
      "scsearch": { "Enabled": true, "CanEnqueue": true },
      "sptfy": { "Enabled": false, "UnavailableReason": "DeploymentVerificationRequired" },
      "amsearch": { "Enabled": false },
      "dzsearch": { "Enabled": false },
      "ymsearch": { "Enabled": false },
      "bcsearch": { "Enabled": false, "UnavailableReason": "SearchSupportUnverified" }
    }
  }
}
