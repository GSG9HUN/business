{
  "AppAuth": {
    "Issuer": "dc-bot-api",
    "Audience": "dc-bot-mobile",
    "SigningKey": "dev-only-change-this-key-to-at-least-32-chars"
  },
  "DiscordOAuth": {
    "ClientId": "DISCORD_CLIENT_ID",
    "ClientSecret": "DISCORD_CLIENT_SECRET",
    "RedirectUri": "https://localhost:5001/api/auth/discord/callback",
    "AndroidRedirectUri": "myapp://auth"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
